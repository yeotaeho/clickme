## API 응답 표준 구조

```python
# 시뮬레이션 최종 리포트 (이 구조 준수)
{
    "simulation_id": "uuid",
    "status": "completed",
    "disclaimer": "본 결과는 AI 시뮬레이션 기반 예측입니다. 실제 성과와 ±20~30% 오차 가능.",
    "executive_summary": {
        "overall_score": int,           # 0~100
        "verdict": "pass|fail|borderline",
        "top_action": str
    },
    "metrics": {
        "ctr_prediction": {"raw": float, "corrected": float, "percentile": str},
        "purchase_intent": float,
        "audience_fit": float,
        "rejection_rate": float,
        "confidence_score": float
    },
    "segment_breakdown": {"age_group": {}, "gender": {}},
    "top_feedbacks": {"positive": [str], "negative": [str]},
    "action_items": [{"priority": "HIGH|MID|LOW", "issue": str, "suggestion": str}],
    "outliers_excluded": int,
    "persona_count_valid": int
}
```

